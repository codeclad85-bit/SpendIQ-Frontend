import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:http/http.dart' as http;

const String baseUrl = 'http://127.0.0.1:8080';

void main() {
  runApp(const SpendIQApp());
}

// =====================================================
// APP
