  // ===================================================
  // PROGRESS
  // ===================================================

  double progressValue(double percentage) {
    if (percentage <= 0) {
      return 0;
    }

    if (percentage >= 100) {
      return 1;
    }

    return percentage / 100;
  }

  // ===================================================
  // STATUS COLOR
  // ===================================================

  Color statusColor(String status) {
    if (status == 'LIMIT_EXCEEDED') {
      return Colors.red;
    }

    if (status == 'WITHIN_LIMIT') {
      return Colors.green;
    }

    return Colors.grey;
  }

  // ===================================================
  // STATUS TEXT
  // ===================================================

  String statusText(String status) {
    if (status == 'LIMIT_EXCEEDED') {
      return 'Limit Exceeded';
    }

    if (status == 'WITHIN_LIMIT') {
      return 'Within Limit';
    }

    return 'Limit Not Set';
  }

  // ===================================================
  // LIMIT CARD
  // ===================================================

  Widget limitCard({
    required String title,
    required double spent,
    required double limit,
    required double percentage,
    required String status,
    required bool loading,
  }) {
    final color = statusColor(status);

    return Card(
      margin: const EdgeInsets.only(bottom: 15),
      elevation: 3,
      child: Padding(
        padding: const EdgeInsets.all(18),
        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment:
                  MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  title,
                  style: const TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                if (loading)
                  const SizedBox(
                    width: 20,
                    height: 20,
                    child: CircularProgressIndicator(
                      strokeWidth: 2,
                    ),
                  ),
              ],
            ),

            const SizedBox(height: 15),

            Text(
              '₹${spent.toStringAsFixed(0)} / ₹${limit.toStringAsFixed(0)}',
              style: const TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.w600,
              ),
            ),

            const SizedBox(height: 10),

            LinearProgressIndicator(
              value: progressValue(percentage),
              minHeight: 8,
              color: color,
              backgroundColor: Colors.grey[300],
            ),

            const SizedBox(height: 10),

            Row(
              mainAxisAlignment:
                  MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  '${percentage.toStringAsFixed(1)}% Used',
                  style: TextStyle(
                    fontWeight: FontWeight.w600,
                    color: color,
                  ),
                ),

                Text(
                  statusText(status),
                  style: TextStyle(
                    fontWeight: FontWeight.bold,
                    color: color,
                  ),
                ),
              ],
            ),

            if (status == 'LIMIT_EXCEEDED')
              Padding(
                padding:
                    const EdgeInsets.only(top: 8),
                child: Text(
                  'Exceeded by ₹${(spent - limit).toStringAsFixed(0)}',
                  style: const TextStyle(
                    color: Colors.red,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }

  String transactionTitle(Map<String, dynamic> expense) {
    final merchant = expense['merchant']?.toString().trim() ?? '';
    final description = expense['description']?.toString().trim() ?? '';
    if (merchant.isNotEmpty) return merchant;
    if (description.isNotEmpty) return description;
    return 'Expense';
  }

  String transactionDate(dynamic value) {
    if (value == null) return 'Date unavailable';
    final date = DateTime.tryParse(value.toString());
    if (date == null) return value.toString();

    const months = [
      'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
      'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
    ];
    final hour12 =
        date.hour == 0 ? 12 : (date.hour > 12 ? date.hour - 12 : date.hour);
    final minute = date.minute.toString().padLeft(2, '0');
    final period = date.hour >= 12 ? 'PM' : 'AM';

    return '${date.day} ${months[date.month - 1]} ${date.year}, '
        '$hour12:$minute $period';
  }

  final List<String> expenseCategories = [
    'Food',
    'Travel',
    'Shopping',
    'Bills',
    'Education',
    'Entertainment',
    'Health',
    'Other',
  ];

  Future<void> updateTransactionCategory(
    Map<String, dynamic> expense,
    String category,
  ) async {
    final id = expense['id'];

    if (id == null) return;

    try {
      final response = await http.put(
        Uri.parse('$baseUrl/api/expenses/$id/details'),
        headers: {
          'Content-Type': 'application/json',
        },
        body: jsonEncode({
          'category': category,
        }),
      );

      if (!mounted) return;

      if (response.statusCode == 200) {
        setState(() {
          expense['category'] = category;
        });

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Category saved: $category'),
            duration: const Duration(seconds: 1),
          ),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Category save failed: ${response.body}'),
          ),
        );
      }
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Category error: $e'),
        ),
      );
    }
  }

  Future<void> updateTransactionReason(
    Map<String, dynamic> expense,
    String reason,
  ) async {
    final id = expense['id'];
    if (id == null) return;

    try {
      final response = await http.put(
        Uri.parse('$baseUrl/api/expenses/$id/details'),
        headers: {
          'Content-Type': 'application/json',
        },
        body: jsonEncode({
          'reason': reason,
        }),
      );

      if (!mounted) return;

      if (response.statusCode == 200) {
        setState(() {
          expense['reason'] = reason;
        });

        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Reason saved successfully'),
            duration: Duration(seconds: 1),
          ),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Reason save failed: ${response.body}'),
          ),
        );
      }
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Reason error: $e'),
        ),
      );
    }
  }

  Future<void> showReasonDialog(
    Map<String, dynamic> expense,
  ) async {
    final controller = TextEditingController(
      text: expense['reason']?.toString() ?? '',
    );

    final result = await showDialog<String>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Text('Expense Reason'),
          content: TextField(
            controller: controller,
            autofocus: true,
            maxLength: 500,
            maxLines: 3,
            decoration: const InputDecoration(
              labelText: 'Reason / Note',
              hintText: 'Example: Breakfast, College books...',
              border: OutlineInputBorder(),
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext);
              },
              child: const Text('Cancel'),
            ),
            ElevatedButton(
              onPressed: () {
                Navigator.pop(
                  dialogContext,
                  controller.text.trim(),
                );
              },
              child: const Text('Save'),
            ),
          ],
        );
      },
    );

    if (result != null && result.isNotEmpty) {
      await updateTransactionReason(
        expense,
        result,
      );
    }
  }

  Widget transactionCard(Map<String, dynamic> expense) {
    final amount =
        (expense['amount'] as num?)?.toDouble() ?? 0;

    final rawSource =
        expense['source']?.toString().trim() ?? '';

    final source =
        rawSource.isEmpty
            ? 'MANUAL'
            : rawSource.toUpperCase();

    final paymentMode =
        expense['paymentMode']?.toString().trim() ?? '';

    final savedCategory =
        expense['category']?.toString().trim();

    final String? selectedCategory =
        savedCategory != null &&
                expenseCategories.contains(savedCategory)
            ? savedCategory
            : null;

    return Card(
      margin: const EdgeInsets.only(bottom: 10),
      elevation: 1,
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                CircleAvatar(
                  child: Icon(
                    source == 'AUTO'
                        ? Icons.auto_awesome
                        : Icons.edit_note,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,
                    children: [
                      Text(
                        transactionTitle(expense),
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          fontWeight: FontWeight.w600,
                          fontSize: 16,
                        ),
                      ),
                      const SizedBox(height: 5),
                      Text(
                        [
                          source,
                          if (paymentMode.isNotEmpty &&
                              paymentMode.toUpperCase() !=
                                  'UNKNOWN')
                            paymentMode.replaceAll('_', ' '),
                          transactionDate(
                            expense['dateTime'],
                          ),
                        ].join(' • '),
                        style: const TextStyle(
                          color: Colors.grey,
                          fontSize: 12,
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(width: 8),
                Text(
                  '-₹${amount.toStringAsFixed(0)}',
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            DropdownButtonFormField<String>(
              initialValue: selectedCategory,
              decoration: const InputDecoration(
                labelText: 'Category',
                prefixIcon: Icon(Icons.category_outlined),
                border: OutlineInputBorder(),
                isDense: true,
              ),
              hint: const Text('Select Category'),
              items: expenseCategories
                  .map(
                    (category) => DropdownMenuItem<String>(
                      value: category,
                      child: Text(category),
                    ),
                  )
                  .toList(),
              onChanged: (category) {
                if (category != null) {
                  updateTransactionCategory(
                    expense,
                    category,
                  );
                }
              },
            ),

            const SizedBox(height: 10),

            if ((expense['reason']?.toString().trim() ?? '').isNotEmpty)
              Padding(
                padding: const EdgeInsets.only(bottom: 8),
                child: Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Icon(
                      Icons.notes,
                      size: 18,
                      color: Colors.grey,
                    ),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        'Reason: ${expense['reason']}',
                        style: const TextStyle(
                          fontSize: 13,
                        ),
                      ),
                    ),
                  ],
                ),
              ),

            Align(
              alignment: Alignment.centerRight,
              child: TextButton.icon(
                onPressed: () {
                  showReasonDialog(expense);
                },
                icon: Icon(
                  (expense['reason']?.toString().trim() ?? '').isEmpty
                      ? Icons.add_comment_outlined
                      : Icons.edit_note,
                ),
                label: Text(
                  (expense['reason']?.toString().trim() ?? '').isEmpty
                      ? 'Add Reason'
                      : 'Edit Reason',
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget recentTransactionsSection() {
    return Card(
      elevation: 3,
      child: Column(
        children: [
          InkWell(
            onTap: () {
              setState(() {
                showTransactions = !showTransactions;
              });
            },
            child: Padding(
              padding: const EdgeInsets.symmetric(
                horizontal: 18,
                vertical: 17,
              ),
              child: Row(
                children: [
                  const Icon(Icons.receipt_long),
                  const SizedBox(width: 12),
                  const Expanded(
                    child: Text(
                      'Recent Transactions',
                      style: TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                  if (loadingExpenses)
                    const SizedBox(
                      width: 18,
                      height: 18,
                      child: CircularProgressIndicator(strokeWidth: 2),
                    )
                  else
                    Icon(
                      showTransactions
                          ? Icons.keyboard_arrow_up
                          : Icons.keyboard_arrow_down,
                    ),
                ],
              ),
            ),
          ),
          if (showTransactions)
            Padding(
              padding: const EdgeInsets.fromLTRB(12, 0, 12, 12),
              child: transactions.isEmpty
                  ? const Padding(
                      padding: EdgeInsets.all(18),
                      child: Text('No transactions found.'),
                    )
                  : Column(
                      children:
                          transactions.take(10).map(transactionCard).toList(),
                    ),
            ),
        ],
      ),
    );
  }

